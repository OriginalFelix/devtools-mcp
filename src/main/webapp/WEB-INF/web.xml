<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keine Annotationen (@WebServlet, @WebFilter …) aus WEB-INF/lib auswerten: mcp-core bringt z.B. einen annotierten
  HttpServletSseServerTransportProvider ohne Default-Konstruktor mit, an dem das Deployment scheitert. Servlets und
  Filter registriert Spring; ServletContainerInitializer (Spring, Vaadin) laufen trotz metadata-complete.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1"
         metadata-complete="true">
</web-app>
